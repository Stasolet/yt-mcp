{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "youtrack": {
      "type": "local",
      "command": ["npx", "-y", "youtrack-mcp"],
      "environment": {
        "YOUTRACK_URL": "https://youtrack.yourcompany.com",
        "YOUTRACK_TOKEN": "{env:YOUTRACK_TOKEN}"
      },
      "enabled": true
    }
  }
}
